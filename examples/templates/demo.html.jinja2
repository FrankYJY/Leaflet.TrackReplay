  // Rebuild the replay, keeping the playback time and run state.
  function rebuildReplay() {
    var wasPlaying = replay && replay.getState() === 'playing';
    var t = replay ? replay.getCurrentTime() : null;
    if (replay) { replay.destroy(); replay = null; }
    createReplay();
    if (t !== null) {
      replay.seek(t);
      if (wasPlaying) { replay.play(); }
    }
  }

  // Switch basemap source: swap the tiles, then rebuild the replay (the map
  // frame's datum changed, so the data must be re-projected).
  function switchSource(sourceId) {
    if (!BASEMAP_SOURCES[sourceId] || sourceId === settings.sourceId) { return; }
    settings.sourceId = sourceId;
    saveSettings();
    removeBaseLayers();
    buildBaseLayers();
    map.addLayer(baseLayers[activeStyleId()]);
    rebuildReplay();
    updateSettingsPanel();
  }

  // Change the declared datum of the input data (WGS-84 ↔ GCJ-02)
  function switchDataDatum(datum) {
    if (datum === settings.dataDatum) { return; }
    settings.dataDatum = datum;
    saveSettings();
    rebuildReplay();
    updateSettingsPanel();
  }

  // Apply a new API key for the active source
  function applyKey(value) {
    if (value === currentKey()) { return; }
    settings.keys[settings.sourceId] = value;
    saveSettings();
    removeBaseLayers();
    buildBaseLayers();
    map.addLayer(baseLayers[activeStyleId()]);
    rebuildReplay();
    updateSettingsPanel();
  }

  createReplay();
  scheduleHolidays(0);

  // ===== 节假日数据（chinese-days 年度 JSON）=====
  // 每台电脑的浏览器各自抓一次、按年缓存；抓不到就只是不显示节日，回放不受影响。
  // 数据源：https://cdn.jsdelivr.net/npm/chinese-days/dist/years/{年}.json
  //   { "holidays": {"2026-01-01": "New Year's Day,元旦,1"}, "workdays": {...} }
  // —— 结构与插件要的两桶完全一致，值原样显示（不转化）。
  var HOLIDAY_URL = 'https://cdn.jsdelivr.net/npm/chinese-days/dist/years/';
  var HOLIDAY_KEY = 'tr-holidays:';
  var HOLIDAY_TTL = 7 * 86400000;        // 已发布的年份：7 天
  var HOLIDAY_TTL_MISSING = 86400000;    // 尚未发布（404）：1 天后重试
  var holidayTimer = null;
  var holidayStatusEl = null;            // 设置面板里的状态行（就地更新，不重建面板）

  function holidayCacheRead(year) {
    try {
      var raw = localStorage.getItem(HOLIDAY_KEY + year);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }         // 隐私模式/被禁用：当作没有缓存
  }
  function holidayCacheWrite(year, rec) {
    try { localStorage.setItem(HOLIDAY_KEY + year, JSON.stringify(rec)); } catch (e) { /* ignore */ }
  }
  function holidayCacheClear() {
    for (var y = 2000; y <= 2100; y++) {
      try { localStorage.removeItem(HOLIDAY_KEY + y); } catch (e) { /* ignore */ }
    }
  }

  /** 需要的年份 = 回放范围跨的年份（按显示时区）∪ 今年 */
  function holidayYears() {
    var set = {};
    set[new Date().getFullYear()] = true;
    var range = (replay && replay.timeEngine) ? replay.timeEngine.getTimeRange() : null;
    if (range && range.end > range.start) {
      var zone = L.TrackReplay.Utils.TimeZone.createZone(replay.getTimeZone());
      var y1 = +zone.dateKey(range.start).slice(0, 4);
      var y2 = +zone.dateKey(range.end).slice(0, 4);
      for (var y = y1; y <= y2; y++) { set[y] = true; }
    }
    return Object.keys(set).map(Number).sort();
  }

  function fetchHolidayYear(year) {
    return fetch(HOLIDAY_URL + year + '.json').then(function (res) {
      if (res.status === 404) { return { missing: true }; }   // 还没发布，不是错误
      if (!res.ok) { throw new Error('HTTP ' + res.status); }
      return res.json().then(function (j) {
        return { holidays: j.holidays || {}, workdays: j.workdays || {} };
      });
    });
  }

  function scheduleHolidays(delay) {
    if (holidayTimer) { clearTimeout(holidayTimer); }
    holidayTimer = setTimeout(function () { ensureHolidays(false); }, delay == null ? 300 : delay);
  }

  /** 缺哪年抓哪年；过期的后台静默重抓；失败退回缓存。抓完 setCalendar（不重建）。 */
  function ensureHolidays(force) {
    if (!replay) { return; }
    var years = holidayYears();
    var now = Date.now();
    var merged = { holidays: {}, workdays: {} };
    var jobs = [];

    years.forEach(function (year) {
      var cached = holidayCacheRead(year);
      var ttl = (cached && cached.missing) ? HOLIDAY_TTL_MISSING : HOLIDAY_TTL;
      var stale = !cached || force || (now - cached.fetchedAt) > ttl;
      var job = stale
        ? fetchHolidayYear(year).then(function (fresh) {
            var saved = {
              fetchedAt: Date.now(),
              missing: !!fresh.missing,
              holidays: fresh.holidays || {},
              workdays: fresh.workdays || {},
            };
            holidayCacheWrite(year, saved);
            return saved;
          }).catch(function () { return cached; })       // 离线/被拦：用旧的
        : Promise.resolve(cached);

      jobs.push(job.then(function (rec) {
        if (!rec || rec.missing) { return; }
        for (var k in rec.holidays) { merged.holidays[k] = rec.holidays[k]; }
        for (var k2 in rec.workdays) { merged.workdays[k2] = rec.workdays[k2]; }
      }));
    });

    Promise.all(jobs).then(function () {
      replay.setCalendar(merged);
      if (holidayStatusEl && holidayStatusEl.parentNode) {
        holidayStatusEl.textContent = holidayStatusText();
      }
    });
  }

  function holidayStatusText() {
    var years = holidayYears();
    var bits = years.map(function (y) {
      var rec = holidayCacheRead(y);
      if (!rec) { return y + ' 未缓存'; }
      if (rec.missing) { return y + ' 尚未发布'; }
      var count = Object.keys(rec.holidays || {}).length + Object.keys(rec.workdays || {}).length;
      var days = Math.max(0, Math.round((Date.now() - rec.fetchedAt) / 86400000));
      return y + ' 已缓存 ' + count + ' 条（' + days + ' 天前更新）';
    });
    return '节假日数据：' + bits.join(' · ');
  }

  /** 时区改了 → 时间轴就地切换，并重算需要的年份（跨年边界会变） */
  function applyTimeZone() {
    if (replay) { replay.setTimeZone(timeZoneSpec()); }
    scheduleHolidays(400);
  }

  function switchTimeZone(value) {
    settings.timeZone = value;
    saveSettings();
    updateSettingsPanel();
    applyTimeZone();
  }

  // ===== Settings panel (modal — the map behind it is inert) =====
  var panelOverlay = null;

  function openSettingsPanel() {
    if (panelOverlay) { return; }
    // Full-size layer inside the map container: it swallows mouse/wheel/touch
    // before they reach Leaflet, so nothing behind it reacts while it is open.
    panelOverlay = L.DomUtil.create('div', 'demo-settings-overlay', map.getContainer());
    L.DomEvent.disableClickPropagation(panelOverlay);
    L.DomEvent.disableScrollPropagation(panelOverlay);
    L.DomEvent.on(panelOverlay, 'click', function (e) {
      if (e.target === panelOverlay) { closeSettingsPanel(); }   // click the backdrop
    });
    var panel = L.DomUtil.create('div', 'demo-settings-panel', panelOverlay);
    buildSettingsPanel(panel);
    document.addEventListener('keydown', onSettingsKeydown);
  }

  function closeSettingsPanel() {
    document.removeEventListener('keydown', onSettingsKeydown);
    if (panelOverlay) { L.DomUtil.remove(panelOverlay); panelOverlay = null; }
  }

  function onSettingsKeydown(e) {
    if (e.key === 'Escape') { closeSettingsPanel(); }
  }

  function updateSettingsPanel() {
    if (!panelOverlay) { return; }
    var panel = panelOverlay.querySelector('.demo-settings-panel');
    if (panel) { panel.innerHTML = ''; buildSettingsPanel(panel); }
  }

  function settingsRow(panel, keyText) {
    var row = L.DomUtil.create('div', 'demo-settings-row', panel);
    var key = L.DomUtil.create('span', 'demo-settings-key', row);
    key.textContent = keyText;
    return row;
  }

  function radioChoice(parent, name, choices, value, onChange) {
    for (var i = 0; i < choices.length; i++) {
      var lab = L.DomUtil.create('label', '', parent);
      var input = L.DomUtil.create('input', '', lab);
      input.type = 'radio';
      input.name = name;
      input.value = choices[i].value;
      input.checked = choices[i].value === value;
      if (onChange) {
        L.DomEvent.on(input, 'change', (function (v) {
          return function () { onChange(v); };
        })(choices[i].value));
      }
      lab.appendChild(document.createTextNode(' ' + choices[i].label));
    }
  }

  function datumLabel(d) { return d === 'gcj02' ? 'GCJ-02（火星）' : 'WGS-84'; }

  function buildSettingsPanel(panel) {
    var head = L.DomUtil.create('h3', '', panel);
    head.appendChild(document.createTextNode('设置'));
    var closeBtn = L.DomUtil.create('span', 'demo-settings-close', head);
    closeBtn.textContent = '✕';
    closeBtn.title = '关闭 (Esc)';
    L.DomEvent.on(closeBtn, 'click', closeSettingsPanel);

    settingsSection(panel, '底图与密钥');

    // 地图来源 — switching sources also switches the map frame's datum
    var sourceRow = settingsRow(panel, '地图来源');
    var sourceChoices = [];
    for (var id in BASEMAP_SOURCES) {
      var src = BASEMAP_SOURCES[id];
      sourceChoices.push({
        value: id,
        label: src.label + (src.datum === 'gcj02' ? ' (GCJ-02)' : ' (WGS-84)') +
          (src.keyRequired ? ' · 需 key' : ''),
      });
    }
    radioChoice(sourceRow, 'demo-source', sourceChoices, settings.sourceId, function (v) { switchSource(v); });

    // API Key — stored per source; appended to tile URLs when non-empty
    var keyRow = settingsRow(panel, currentSource().keyRequired ? 'API Key *' : 'API Key');
    var keyInput = L.DomUtil.create('input', 'demo-settings-input', keyRow);
    keyInput.type = 'text';
    keyInput.placeholder = currentSource().keyHint || '';
    keyInput.value = currentKey();
    L.DomEvent.on(keyInput, 'change', function () { applyKey(keyInput.value.trim()); });

    settingsSection(panel, '坐标系');

    // 数据坐标系 — the datum the INPUT data is in
    var datumRow = settingsRow(panel, '数据坐标系');
    radioChoice(datumRow, 'demo-datum', [
      { value: 'wgs84', label: 'WGS-84 (GPS)' },
      { value: 'gcj02', label: 'GCJ-02 (火星)' },
    ], settings.dataDatum, function (v) { switchDataDatum(v); });

    // 坐标转换 — derived, not an independent switch: it is exactly
    // (底图坐标系 ≠ 数据坐标系). Picking 高德 (GCJ-02) turns it on
    // automatically; picking a WGS-84 source turns it off.
    var mapDatum = currentSource().datum;
    var converting = mapDatum !== settings.dataDatum;
    var missingKey = currentSource().keyRequired && !currentKey();
    var status = L.DomUtil.create('div', 'demo-settings-status', panel);
    status.innerHTML =
      '底图坐标系：<b>' + datumLabel(mapDatum) + '</b>　数据坐标系：<b>' + datumLabel(settings.dataDatum) + '</b><br>' +
      '坐标转换：' + (converting
        ? '<span class="on">开</span> · ' + datumLabel(settings.dataDatum) + ' → ' + datumLabel(mapDatum)
        : '<span class="off">关</span> · 两者相同，无需转换') +
      (missingKey
        ? '<br><span class="warn">该来源必须填写 tk：请在上方 API Key 栏填入后生效（当前瓦片不会加载）</span>'
        : '');

    var hint = L.DomUtil.create('div', 'demo-settings-hint', panel);
    hint.innerHTML =
      '底图风格（标准 / 卫星 / 深色…）用右上角图层控件的“底图”单选组切换。<br>' +
      '底图与数据坐标系一致时原生对齐；不一致时数据在解析时转换一次。地图上' +
      '显示、量测得到的坐标始终是<b>底图坐标系</b>。设置会被记住（localStorage）。';

    // ---- 时间与时区 ----
    settingsSection(panel, '时间与时区');

    var tzRow = settingsRow(panel, '显示时区');
    radioChoice(tzRow, 'demo-tz', [
      { value: 'browser', label: '浏览器默认' },
      { value: 'utc8', label: 'UTC+8' },
      { value: 'custom', label: '自定义' },
    ], settings.timeZone, function (v) { switchTimeZone(v); });

    if (settings.timeZone === 'custom') {
      var offsetRow = settingsRow(panel, '偏移 (小时)');
      var offsetInput = L.DomUtil.create('input', 'demo-settings-input', offsetRow);
      offsetInput.type = 'number';
      offsetInput.step = '0.5';
      offsetInput.min = '-12';
      offsetInput.max = '14';
      offsetInput.value = String(settings.timeZoneOffset);
      L.DomEvent.on(offsetInput, 'change', function () {
        var v = parseFloat(offsetInput.value);
        if (isFinite(v) && v >= -12 && v <= 14) {
          settings.timeZoneOffset = v;
          saveSettings();
          applyTimeZone();
        }
      });
    }

    // 节假日数据（chinese-days 年度 JSON，按年缓存）
    var holidayRow = settingsRow(panel, '节假日数据');
    var refreshBtn = L.DomUtil.create('button', 'demo-settings-btn', holidayRow);
    refreshBtn.type = 'button';
    refreshBtn.textContent = '立即更新';
    L.DomEvent.on(refreshBtn, 'click', function () { ensureHolidays(true); });
    var clearBtn = L.DomUtil.create('button', 'demo-settings-btn', holidayRow);
    clearBtn.type = 'button';
    clearBtn.textContent = '清除缓存';
    L.DomEvent.on(clearBtn, 'click', function () {
      holidayCacheClear();
      ensureHolidays(true);
    });

    holidayStatusEl = L.DomUtil.create('div', 'demo-settings-status', panel);
    holidayStatusEl.textContent = holidayStatusText();

    var tzHint = L.DomUtil.create('div', 'demo-settings-hint', panel);
    tzHint.innerHTML =
      '显示时区决定时间轴怎么读：时间标签、双击编辑、进度条上的<b>日界线</b>、' +
      '以及节假日按哪一天查表，全部跟着它走（默认跟随浏览器）。<br>' +
      '节假日数据来自 chinese-days 的年度 JSON（结构与插件一致，值原样显示）；' +
      '每台电脑的浏览器各自按年缓存在 localStorage，抓不到时只是不显示节日，不影响回放。';
  }

  function settingsSection(panel, title) {
    var el = L.DomUtil.create('div', 'demo-settings-section', panel);
    el.textContent = title;
    return el;
  }

  // ===== Keyboard shortcuts =====
  // The playback keys (Space / ←→ / 0-9 / r) are focus-scoped inside the
  // plugin now: click the playback bar to arm them (the focused control gets
  // an outline). One click on the map arms Space only. No global handler is
  // installed here, so typing anywhere (search box, import panel, time
  // editor) never triggers playback actions.

  console.log('Leaflet.TrackReplay demo ready!');
  console.log('  Click the playback bar, then:');
  console.log('    Space = Play/Pause');
  console.log('    ← →  = Seek ±5s');
  console.log('    R     = Stop');
  console.log('    1-9   = Speed (Nth option: 0.25× … 8×, 1s=1min, 1s=10min, 1s=1h)');
  console.log('    0     = 1×');
  console.log('  Or click the map: Space toggles play/pause.');
  console.log('  State:', replay.getState());
  console.log('  Legend:', replay.getLegend(10));
</script>

</body>
</html>
