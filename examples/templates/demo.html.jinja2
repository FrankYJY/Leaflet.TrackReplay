<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leaflet.TrackReplay — Demo</title>

  <!-- Leaflet CSS (vendored locally — the page must not depend on CDNs) -->
  <link rel="stylesheet" href="/vendor/leaflet.css" />

  <!-- MarkerCluster CSS (optional, for point clustering) -->
  <link rel="stylesheet" href="/vendor/MarkerCluster.css" />
  <link rel="stylesheet" href="/vendor/MarkerCluster.Default.css" />

  <!-- Hierarchical layer control CSS (optional, gives a tree layer control) -->
  <link rel="stylesheet" href="/vendor/L.Control.Layers.Tree.css" />

  <!-- Fullscreen + measure tool CSS (optional helpers) -->
  <link rel="stylesheet" href="/vendor/leaflet.fullscreen.css" />
  <link rel="stylesheet" href="/vendor/leaflet-measure.css" />

  <!-- Plugin CSS (local build) -->
  <link rel="stylesheet" href="/dist/leaflet-trackreplay.css" />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    #map { height: 100%; width: 100%; }

    /* Info overlay — top-center so it doesn't cover the legend (bottom-right)
       or the playback controls (top-left / top-right) */
    .demo-info {
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255,255,255,0.92);
      padding: 10px 14px;
      border-radius: 6px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      font-size: 12px;
      color: #555;
      z-index: 1000;
      pointer-events: none;
      text-align: center;
    }
    .demo-info strong { color: #333; }

    /* ---- Settings control + modal panel (demo host UI, not plugin code) ---- */
    .demo-settings-gear { font-size: 15px; }
    .demo-settings-overlay {
      position: absolute;
      inset: 0;
      z-index: 2500;              /* above Leaflet's control layer (1000) */
      background: rgba(0, 0, 0, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .demo-settings-panel {
      background: #fff;
      border-radius: 6px;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
      padding: 14px 16px;
      font-size: 13px;
      color: #333;
      min-width: 340px;
      max-width: 90%;
    }
    .demo-settings-panel h3 {
      font-size: 14px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .demo-settings-close {
      cursor: pointer;
      color: #888;
      font-size: 15px;
      line-height: 1;
      padding: 2px 6px;
      border-radius: 3px;
    }
    .demo-settings-close:hover { background: #f0f0f0; color: #333; }
    .demo-settings-row { display: flex; align-items: center; gap: 8px; margin: 9px 0; }
    .demo-settings-row > .demo-settings-key { width: 80px; flex: none; color: #666; }
    .demo-settings-row label { cursor: pointer; margin-right: 12px; white-space: nowrap; }
    .demo-settings-input {
      flex: 1;
      padding: 4px 6px;
      border: 1px solid #ccc;
      border-radius: 3px;
      font-size: 12px;
      min-width: 0;
    }
    .demo-settings-status {
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 4px;
      background: #f6f8fa;
      font-size: 12px;
      line-height: 1.7;
      color: #555;
    }
    .demo-settings-status .on { color: #1a7f37; font-weight: bold; }
    .demo-settings-status .off { color: #888; }
    .demo-settings-status .warn { color: #b45309; font-weight: bold; }
    .demo-settings-hint { color: #999; font-size: 11px; line-height: 1.5; margin-top: 8px; }
  </style>
</head>
<body>

<div id="map"></div>

<div class="demo-info">
  <strong>Leaflet.TrackReplay</strong> — Demo<br>
  Data: {{ data.features | length }} features,
  {% set ts_count = data.features | selectattr('properties.isTimestampedgeojson') | list | length %}
  {{ ts_count }} timestamped<br>
  Time range: {{ time_min }} – {{ time_max }}<br>
  <small>Scroll to zoom • Drag to pan • Double-click time to edit<br>
  点击播放条或地图后可用键盘快捷键</small>
</div>

<!-- Leaflet JS (vendored locally — the page must not depend on CDNs) -->
<script src="/vendor/leaflet.js"></script>

<!-- MarkerCluster JS (optional) -->
<script src="/vendor/leaflet.markercluster.js"></script>

<!-- Hierarchical layer control JS (optional, used by the plugin when present) -->
<script src="/vendor/L.Control.Layers.Tree.js"></script>

<!-- Fullscreen + measure tool JS (optional helpers; the measure bundle is the Chinese locale) -->
<script src="/vendor/Leaflet.fullscreen.js"></script>
<script src="/vendor/leaflet-measure.cn.js"></script>

<!-- Plugin JS (local build) -->
<script src="/dist/leaflet-trackreplay.umd.js"></script>

<script>
  // ===== Embed the data from Python =====
  var trackData = {{ data_json | safe }};

  // ===== Initialize map =====
  var map = L.map('map', {
    center: [39.91, 116.41],
    zoom: 14,
    zoomControl: false,       // re-added below, so the settings gear sits above it
    preferCanvas: true,
  });

  // ===== Basemap sources =====
  // Two axes decide the coordinate behaviour:
  //   source.datum — the datum the tiles are drawn in (GCJ-02 for 高德/AMap)
  //   dataDatum    — the datum of the input track data (settings panel)
  // When they differ, TrackReplay converts the data once, at parse time, so
  // everything on the map (tracks, points, events, indicators) lines up with
  // the tiles and keeps working in one consistent frame.
  var BASEMAP_SOURCES = {
    osm: {
      label: 'OpenStreetMap',
      datum: 'wgs84',
      keyHint: '该来源无需 API Key',
      styles: [
        { id: 'osm-standard', label: '标准', create: function () {
          return L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19,
          });
        } },
        { id: 'carto-positron', label: '浅色 (Carto)', create: function () {
          return L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            subdomains: 'abcd', maxZoom: 20, detectRetina: true,
          });
        } },
        { id: 'carto-dark', label: '深色 (Carto)', create: function () {
          return L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            subdomains: 'abcd', maxZoom: 20, detectRetina: true,
          });
        } },
        { id: 'esri-imagery', label: '卫星 (Esri)', create: function () {
          return L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics',
            maxZoom: 19,
          });
        } },
      ],
    },
    amap: {
      label: '高德地图',
      datum: 'gcj02',           // 高德 tiles are rendered in GCJ-02 (火星坐标系)
      keyHint: '高德栅格瓦片接口通常无需 key，可留空',
      styles: [
        { id: 'amap-vector', label: '标准', create: function (key) {
          return L.tileLayer('https://webrd0{s}.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}' + keyParam('key', key), {
            subdomains: ['1', '2', '3', '4'], maxNativeZoom: 18, maxZoom: 19, attribution: '&copy; 高德地图',
          });
        } },
        { id: 'amap-satellite', label: '卫星', create: function (key) {
          return L.tileLayer('https://webst0{s}.is.autonavi.com/appmaptile?style=6&x={x}&y={y}&z={z}' + keyParam('key', key), {
            subdomains: ['1', '2', '3', '4'], maxNativeZoom: 18, maxZoom: 19, attribution: '&copy; 高德地图',
          });
        } },
        { id: 'amap-hybrid', label: '卫星 + 路网', create: function (key) {
          var sat = L.tileLayer('https://webst0{s}.is.autonavi.com/appmaptile?style=6&x={x}&y={y}&z={z}' + keyParam('key', key), {
            subdomains: ['1', '2', '3', '4'], maxNativeZoom: 18, maxZoom: 19, attribution: '&copy; 高德地图',
          });
          var roads = L.tileLayer('https://webst0{s}.is.autonavi.com/appmaptile?style=8&x={x}&y={y}&z={z}' + keyParam('key', key), {
            subdomains: ['1', '2', '3', '4'], maxNativeZoom: 18, maxZoom: 19,
          });
          return L.layerGroup([sat, roads]);
        } },
      ],
    },
    tianditu: {
      label: '天地图',
      datum: 'wgs84',           // CGCS2000 ≈ WGS-84 — GPS data needs no conversion
      keyRequired: true,        // tk from tianditu.gov.cn (free registration)
      keyHint: '必填：tianditu.gov.cn 免费注册获取 tk（注意 referrer 绑定）',
      styles: [
        { id: 'tdt-vector', label: '矢量', create: function (key) {
          return tdtGroup('vec', 'cva', 18, key);
        } },
        { id: 'tdt-imagery', label: '影像', create: function (key) {
          return tdtGroup('img', 'cia', 18, key);
        } },
        { id: 'tdt-terrain', label: '地形', create: function (key) {
          return tdtGroup('ter', 'cta', 14, key);
        } },
      ],
    },
  };

  // The key field is generic: appended to the tile URL when non-empty, so a
  // provider that grows a key requirement needs no code change. The parameter
  // name is per provider (高德: key, 天地图: tk).
  function keyParam(name, key) { return key ? '&' + name + '=' + encodeURIComponent(key) : ''; }

  // 天地图 WMTS: every style is a base layer plus its annotation layer
  // (vec+cva / img+cia / ter+cta), both on the web-mercator tile matrix set.
  function tdtGroup(baseLayer, labelLayer, maxNativeZoom, key) {
    var mk = function (layer) {
      return L.tileLayer('https://t{s}.tianditu.gov.cn/' + layer + '_w/wmts' +
        '?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=' + layer + '&STYLE=default' +
        '&TILEMATRIXSET=w&FORMAT=tiles&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}' + keyParam('tk', key), {
        subdomains: ['0', '1', '2', '3', '4', '5', '6', '7'],
        maxNativeZoom: maxNativeZoom, maxZoom: 19,
        attribution: '&copy; 天地图',
      });
    };
    return L.layerGroup([mk(baseLayer), mk(labelLayer)]);
  }

  // ===== Settings (persisted in localStorage) =====
  var SETTINGS_KEY = 'tr-demo-settings';
  // Bumped when the default basemap changes: settings saved by an older
  // version re-default the source once (API keys and the per-source style
  // memory are kept). v2 → default basemap is 高德 (AMap).
  var SETTINGS_VERSION = 2;
  var settings = loadSettings();
  var baseLayers = {};        // styleId → L.Layer, for the active source
  var replay = null;

  function loadSettings() {
    var s = {};
    try { s = JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}'); } catch (e) { s = {}; }
    var keepSource = s.v === SETTINGS_VERSION && BASEMAP_SOURCES[s.sourceId];
    return {
      v: SETTINGS_VERSION,
      sourceId: keepSource ? s.sourceId : 'amap',        // default basemap: 高德
      styles: s.styles || {},                            // sourceId → remembered styleId
      dataDatum: s.dataDatum === 'gcj02' ? 'gcj02' : 'wgs84',
      keys: s.keys || {},                                // sourceId → API key
    };
  }
  function saveSettings() {
    try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch (e) { /* ignore */ }
  }
  function currentSource() { return BASEMAP_SOURCES[settings.sourceId]; }
  function currentKey() { return settings.keys[settings.sourceId] || ''; }
  function activeStyleId() {
    var styles = currentSource().styles;
    var wanted = settings.styles[settings.sourceId];
    for (var i = 0; i < styles.length; i++) { if (styles[i].id === wanted) { return wanted; } }
    return styles[0].id;
  }
  function buildBaseLayers() {
    baseLayers = {};
    var styles = currentSource().styles;
    var key = currentKey();
    for (var i = 0; i < styles.length; i++) {
      baseLayers[styles[i].id] = styles[i].create(key);
    }
  }
  function baseLayerList() {
    var styles = currentSource().styles;
    var out = [];
    for (var i = 0; i < styles.length; i++) {
      out.push({ label: styles[i].label, layer: baseLayers[styles[i].id] });
    }
    return out;
  }
  function styleIdOf(layer) {
    for (var id in baseLayers) { if (baseLayers[id] === layer) { return id; } }
    return null;
  }

  // Remove whichever style layer of the CURRENT source is on the map. The user
  // may have switched styles in the layer tree's radio group, so a cached
  // "active layer" reference would go stale — scan the registry instead.
  function removeBaseLayers() {
    for (var id in baseLayers) {
      if (map.hasLayer(baseLayers[id])) { map.removeLayer(baseLayers[id]); }
    }
  }

  // Remember the basemap style picked in the layer tree's radio group.
  // (Watching layeradd is provider-agnostic — it doesn't depend on the layer
  // control firing baselayerchange.)
  map.on('layeradd', function (e) {
    var id = styleIdOf(e.layer);
    if (id) { settings.styles[settings.sourceId] = id; saveSettings(); }
  });

  // Initial basemap from the persisted settings
  buildBaseLayers();
  map.addLayer(baseLayers[activeStyleId()]);

  // Add scale control
  L.control.scale({ position: 'bottomright', metric: true, imperial: false }).addTo(map);

  // Settings gear (top-left, above the zoom control) — opens a modal panel
  var SettingsControl = L.Control.extend({
    options: { position: 'topleft' },
    onAdd: function () {
      var wrap = L.DomUtil.create('div', 'leaflet-bar');
      var link = L.DomUtil.create('a', 'demo-settings-gear', wrap);
      link.href = '#';
      link.title = '设置';
      link.setAttribute('aria-label', '设置');
      link.innerHTML = '&#9881;';
      L.DomEvent.on(link, 'click', function (ev) {
        L.DomEvent.stop(ev);
        openSettingsPanel();
      });
      return wrap;
    },
  });
  new SettingsControl().addTo(map);
  L.control.zoom({ position: 'topleft' }).addTo(map);

  // Fullscreen (Leaflet.fullscreen)
  L.control.fullscreen({
    position: 'topleft',
    title: '全屏',
    titleCancel: '退出全屏',
  }).addTo(map);

  // ---- leaflet-measure × Leaflet ≥ 1.8 compatibility shim ----
  // While measuring, leaflet-measure adds a helper marker whose divIcon is 2×
  // the map size and is focusable (tabindex="0") — it catches clicks across
  // the whole map. Since Leaflet 1.8, focusing a marker runs Marker._panOnFocus
  // → map.panInside(latlng, {paddingBottomRight: iconSize}), so with that
  // oversized icon every click yanks the map away (and mousedown/mouseup end up
  // on different spots, so the click never completes → no measurement point).
  // Skip pan-on-focus for such oversized helper markers.
  if (L.Marker.prototype._panOnFocus) {
    var origPanOnFocus = L.Marker.prototype._panOnFocus;
    L.Marker.prototype._panOnFocus = function () {
      var io = (this.options.icon && this.options.icon.options) || {};
      var size = io.iconSize;
      // iconSize may be an [x, y] array or an L.Point
      var w = size ? (size.x !== undefined ? size.x : size[0]) : 0;
      var h = size ? (size.y !== undefined ? size.y : size[1]) : 0;
      if (w >= 1000 || h >= 1000) { return; }
      return origPanOnFocus.call(this);
    };
  }

  // Measure tool (leaflet-measure) — 距离/面积测量
  L.control.measure({
    position: 'topleft',
    primaryLengthUnit: 'meters',
    secondaryLengthUnit: 'kilometers',
    primaryAreaUnit: 'sqmeters',
    secondaryAreaUnit: 'hectares',
  }).addTo(map);

  // ===== TrackReplay =====
  // (Re)create the replay instance. Called at startup and again whenever the
  // basemap source or the data datum changes — both decide the coordinate
  // frame the input data has to be converted into, so the layers are rebuilt.
  function createReplay() {
    replay = L.trackReplay(map, trackData, {
      colorMode: 'fixed',       // 'fixed' | 'adaptive' | 'custom'
      speed: 1,
      loop: false,
      tickLen: 100,             // smooth 10fps
      showControls: true,
      showTimeline: true,
      showLegend: true,
      showViewFollow: true,
      // ---- Coordinate frames (see the GCJ-02 note above) ----
      dataDatum: settings.dataDatum,      // datum of the input track data
      mapDatum: currentSource().datum,    // datum of the active basemap
      // Basemap styles appear as the layer tree's radio group ("底图")
      baseLayers: baseLayerList(),
      baseLayersLabel: '底图',
      // Each display element of every object gets its own toggleable layer
      elementLabels: {
        track: '轨迹',
        points: '节点',
        static: '静态',
        events: '事件',
        background_nodes: '背景节点',
        traveled: '已行进',
        untraveled: '未行进',
        indicator: '箭头',
      },
      // Batch control: one tri-state checkbox per element type, for all objects
      showElementToggles: true,
      elementTogglesTitle: '批量',
      // Batch label display control (rows = objects, columns = element types):
      // checking a cell batch-opens those existing popups
      showInfoLabels: true,
      infoLabelsTitle: '批量标签',
      // Cluster / scatter settings panel — its background-nodes section
      // switches that element between clustered and raw scatter rendering
      clusterScatterTitle: '聚合散点设置',
      clusterScatterLabels: { cluster: '聚合', scatter: '散点' },
      // Data source panel — manage the session's datasets (list / remove /
      // clear) and import new ones (file pick, drag & drop onto the map,
      // paste, URL, or the built-in samples below)
      showDataSource: true,
      dataSourceTitle: '数据源',
      dataSourceLabels: {
        pick: '选择文件…',
        add: '添加',
        load: '加载',
        pastePlaceholder: '粘贴 GeoJSON / GPX 文本…',
        urlPlaceholder: '或输入 GeoJSON / GPX 的 URL',
        samplesLabel: '示例',
        dropHint: '松开鼠标即可导入',
        pastedName: '贴入数据',
        datasetsLabel: '数据集',
        importLabel: '导入',
        removeLabel: '移除',
        clearLabel: '清空',
        clearConfirmLabel: '确认清空？',
        emptyLabel: '（暂无数据）',
      },
      dataSourceMessages: {
        added: function (fc, meta) {
          var s = '已加入「' + meta.name + '」：' + fc.features.length + ' 个要素';
          if (meta.report) {
            s += '（' + meta.report.segments + ' 段轨迹 / ' + meta.report.points + ' 个点）';
          }
          return s;
        },
        degraded: function (report, name) {
          return '「' + name + '」有 ' + report.staticSegments +
            ' 段没有时间戳，已作为静态线导入（不参与回放）';
        },
        empty: function (name) { return '「' + name + '」中没有可导入的轨迹或航点'; },
        error: function (err, name) {
          return '「' + name + '」导入失败：' + (err && err.message ? err.message : err);
        },
        rowMeta: function (d) { return d.featureCount + ' 个要素'; },
      },
      // Multi-search (leaflet-multisearch): searches the background nodes'
      // label texts — every occurrence is a hit (duplicates included), with
      // a hit count and Enter / ◀ / ▶ cycling that opens each node's popup
      showSearch: true,
      searchPosition: 'topleft',
      searchElements: ['background_nodes'],
      searchZoom: 17,
      searchLabels: {
        open: '搜索',
        close: '收起',
        placeholder: '搜索背景节点…',
        prev: '上一个',
        next: '下一个',
      },
      searchMessages: {
        count: function (n) { return n + ' 处'; },
        of: function (i, n) { return i + '/' + n; },
        more: function (shown, total) { return '… 显示前 ' + shown + ' 条，共 ' + total + ' 处'; },
        empty: function () { return '无匹配'; },
      },
      dataSourceSamples: [
        { label: '示例轨迹', data: function () {
            var t0 = Date.now(), coords = [], times = [];
            for (var i = 0; i < 40; i++) {
              var r = 0.004 * (1 + i / 30);
              coords.push([116.40 + r * Math.cos(i / 6), 39.90 + 0.75 * r * Math.sin(i / 6)]);
              times.push(t0 + i * 5000);
            }
            return { type: 'FeatureCollection', features: [{
              type: 'Feature',
              geometry: { type: 'LineString', coordinates: coords },
              properties: {
                layerPath: ['导入', '示例轨迹'], isTimestampedgeojson: true,
                times: times, drawMovingIndicator: true,
              },
            }] };
        } },
        { label: '示例采样点', data: function () {
            var coords = [], popups = [];
            for (var i = 0; i < 30; i++) {
              coords.push([116.39 + Math.random() * 0.04, 39.88 + Math.random() * 0.04]);
              popups.push('示例采样点 #' + i);
            }
            return { type: 'FeatureCollection', features: [{
              type: 'Feature',
              geometry: { type: 'MultiPoint', coordinates: coords },
              properties: {
                layerPath: ['导入', '示例采样点'], element: 'background_nodes',
                popups: popups,
              },
            }] };
        } },
      ],
    });

    // ===== Log events =====
    replay.on('start', function (d) { console.log('[trackreplay] start', d.time); });
    replay.on('pause', function (d) { console.log('[trackreplay] pause', d.time); });
    replay.on('stop', function (d) { console.log('[trackreplay] stop', d.time); });
    replay.on('finished', function (d) { console.log('[trackreplay] finished', d.time); });
  }

  // Rebuild the replay, keeping the playback time and run state.
  function rebuildReplay() {
    var wasPlaying = replay && replay.getState() === 'playing';
    var t = replay ? replay.getCurrentTime() : null;
    if (replay) { replay.destroy(); replay = null; }
    createReplay();
    if (t !== null) {
      replay.seek(t);
      if (wasPlaying) { replay.play(); }
    }
  }

  // Switch basemap source: swap the tiles, then rebuild the replay (the map
  // frame's datum changed, so the data must be re-projected).
  function switchSource(sourceId) {
    if (!BASEMAP_SOURCES[sourceId] || sourceId === settings.sourceId) { return; }
    settings.sourceId = sourceId;
    saveSettings();
    removeBaseLayers();
    buildBaseLayers();
    map.addLayer(baseLayers[activeStyleId()]);
    rebuildReplay();
    updateSettingsPanel();
  }

  // Change the declared datum of the input data (WGS-84 ↔ GCJ-02)
  function switchDataDatum(datum) {
    if (datum === settings.dataDatum) { return; }
    settings.dataDatum = datum;
    saveSettings();
    rebuildReplay();
    updateSettingsPanel();
  }

  // Apply a new API key for the active source
  function applyKey(value) {
    if (value === currentKey()) { return; }
    settings.keys[settings.sourceId] = value;
    saveSettings();
    removeBaseLayers();
    buildBaseLayers();
    map.addLayer(baseLayers[activeStyleId()]);
    rebuildReplay();
    updateSettingsPanel();
  }

  createReplay();

  // ===== Settings panel (modal — the map behind it is inert) =====
  var panelOverlay = null;

  function openSettingsPanel() {
    if (panelOverlay) { return; }
    // Full-size layer inside the map container: it swallows mouse/wheel/touch
    // before they reach Leaflet, so nothing behind it reacts while it is open.
    panelOverlay = L.DomUtil.create('div', 'demo-settings-overlay', map.getContainer());
    L.DomEvent.disableClickPropagation(panelOverlay);
    L.DomEvent.disableScrollPropagation(panelOverlay);
    L.DomEvent.on(panelOverlay, 'click', function (e) {
      if (e.target === panelOverlay) { closeSettingsPanel(); }   // click the backdrop
    });
    var panel = L.DomUtil.create('div', 'demo-settings-panel', panelOverlay);
    buildSettingsPanel(panel);
    document.addEventListener('keydown', onSettingsKeydown);
  }

  function closeSettingsPanel() {
    document.removeEventListener('keydown', onSettingsKeydown);
    if (panelOverlay) { L.DomUtil.remove(panelOverlay); panelOverlay = null; }
  }

  function onSettingsKeydown(e) {
    if (e.key === 'Escape') { closeSettingsPanel(); }
  }

  function updateSettingsPanel() {
    if (!panelOverlay) { return; }
    var panel = panelOverlay.querySelector('.demo-settings-panel');
    if (panel) { panel.innerHTML = ''; buildSettingsPanel(panel); }
  }

  function settingsRow(panel, keyText) {
    var row = L.DomUtil.create('div', 'demo-settings-row', panel);
    var key = L.DomUtil.create('span', 'demo-settings-key', row);
    key.textContent = keyText;
    return row;
  }

  function radioChoice(parent, name, choices, value, onChange) {
    for (var i = 0; i < choices.length; i++) {
      var lab = L.DomUtil.create('label', '', parent);
      var input = L.DomUtil.create('input', '', lab);
      input.type = 'radio';
      input.name = name;
      input.value = choices[i].value;
      input.checked = choices[i].value === value;
      if (onChange) {
        L.DomEvent.on(input, 'change', (function (v) {
          return function () { onChange(v); };
        })(choices[i].value));
      }
      lab.appendChild(document.createTextNode(' ' + choices[i].label));
    }
  }

  function datumLabel(d) { return d === 'gcj02' ? 'GCJ-02（火星）' : 'WGS-84'; }

  function buildSettingsPanel(panel) {
    var head = L.DomUtil.create('h3', '', panel);
    head.appendChild(document.createTextNode('设置'));
    var closeBtn = L.DomUtil.create('span', 'demo-settings-close', head);
    closeBtn.textContent = '✕';
    closeBtn.title = '关闭 (Esc)';
    L.DomEvent.on(closeBtn, 'click', closeSettingsPanel);

    // 地图来源 — switching sources also switches the map frame's datum
    var sourceRow = settingsRow(panel, '地图来源');
    var sourceChoices = [];
    for (var id in BASEMAP_SOURCES) {
      var src = BASEMAP_SOURCES[id];
      sourceChoices.push({
        value: id,
        label: src.label + (src.datum === 'gcj02' ? ' (GCJ-02)' : ' (WGS-84)') +
          (src.keyRequired ? ' · 需 key' : ''),
      });
    }
    radioChoice(sourceRow, 'demo-source', sourceChoices, settings.sourceId, function (v) { switchSource(v); });

    // API Key — stored per source; appended to tile URLs when non-empty
    var keyRow = settingsRow(panel, currentSource().keyRequired ? 'API Key *' : 'API Key');
    var keyInput = L.DomUtil.create('input', 'demo-settings-input', keyRow);
    keyInput.type = 'text';
    keyInput.placeholder = currentSource().keyHint || '';
    keyInput.value = currentKey();
    L.DomEvent.on(keyInput, 'change', function () { applyKey(keyInput.value.trim()); });

    // 数据坐标系 — the datum the INPUT data is in
    var datumRow = settingsRow(panel, '数据坐标系');
    radioChoice(datumRow, 'demo-datum', [
      { value: 'wgs84', label: 'WGS-84 (GPS)' },
      { value: 'gcj02', label: 'GCJ-02 (火星)' },
    ], settings.dataDatum, function (v) { switchDataDatum(v); });

    // 坐标转换 — derived, not an independent switch: it is exactly
    // (底图坐标系 ≠ 数据坐标系). Picking 高德 (GCJ-02) turns it on
    // automatically; picking a WGS-84 source turns it off.
    var mapDatum = currentSource().datum;
    var converting = mapDatum !== settings.dataDatum;
    var missingKey = currentSource().keyRequired && !currentKey();
    var status = L.DomUtil.create('div', 'demo-settings-status', panel);
    status.innerHTML =
      '底图坐标系：<b>' + datumLabel(mapDatum) + '</b>　数据坐标系：<b>' + datumLabel(settings.dataDatum) + '</b><br>' +
      '坐标转换：' + (converting
        ? '<span class="on">开</span> · ' + datumLabel(settings.dataDatum) + ' → ' + datumLabel(mapDatum)
        : '<span class="off">关</span> · 两者相同，无需转换') +
      (missingKey
        ? '<br><span class="warn">该来源必须填写 tk：请在上方 API Key 栏填入后生效（当前瓦片不会加载）</span>'
        : '');

    var hint = L.DomUtil.create('div', 'demo-settings-hint', panel);
    hint.innerHTML =
      '底图风格（标准 / 卫星 / 深色…）用右上角图层控件的“底图”单选组切换。<br>' +
      '底图与数据坐标系一致时原生对齐；不一致时数据在解析时转换一次。地图上' +
      '显示、量测得到的坐标始终是<b>底图坐标系</b>。设置会被记住（localStorage）。';
  }

  // ===== Keyboard shortcuts =====
  // The playback keys (Space / ←→ / 0-9 / r) are focus-scoped inside the
  // plugin now: click the playback bar to arm them (the focused control gets
  // an outline). One click on the map arms Space only. No global handler is
  // installed here, so typing anywhere (search box, import panel, time
  // editor) never triggers playback actions.

  console.log('Leaflet.TrackReplay demo ready!');
  console.log('  Click the playback bar, then:');
  console.log('    Space = Play/Pause');
  console.log('    ← →  = Seek ±5s');
  console.log('    R     = Stop');
  console.log('    1-9   = Speed (Nth option: 0.25× … 8×, 1s=1min, 1s=10min, 1s=1h)');
  console.log('    0     = 1×');
  console.log('  Or click the map: Space toggles play/pause.');
  console.log('  State:', replay.getState());
  console.log('  Legend:', replay.getLegend(10));
</script>

</body>
</html>
